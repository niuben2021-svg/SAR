# ARM server (SBSA), not Jetson/L4T. CUDA runtime is supplied by official wheels.
ARG PYTHON_BASE=python:3.11-slim-bookworm
FROM ${PYTHON_BASE}
COPY requirements-container.txt /tmp/requirements.txt
RUN test "$(uname -m)" = aarch64 \
    && apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev git \
    && python -m pip install --no-cache-dir \
       'https://download.pytorch.org/whl/cu126/torch-2.9.1%2Bcu126-cp311-cp311-manylinux_2_28_aarch64.whl#sha256=a1641ad5278e8d830f31eee2f628627d42c53892e1770d1d1e1c475576d327f7' \
       'https://download.pytorch.org/whl/cu126/torchvision-0.24.1-cp311-cp311-manylinux_2_28_aarch64.whl#sha256=6b2623f609a879c0c644e306d9cba7fe15ba13a992f8cbcaabc5cb0c62424717' \
       --extra-index-url https://download.pytorch.org/whl/cu126 \
    && printf 'torch==2.9.1+cu126\ntorchvision==0.24.1\npeft==0.20.0\n' > /tmp/constraints.txt \
    && python -m pip install --no-cache-dir -c /tmp/constraints.txt -r /tmp/requirements.txt peft==0.20.0 \
    && python -m pip check \
    && python -c 'import platform,torch,torchvision; assert platform.machine()=="aarch64"; assert torch.version.cuda=="12.6"; assert torch.cuda._is_compiled(); assert torchvision.extension._check_cuda_version()>0; from transformers import Qwen3VLForConditionalGeneration; from swift.arguments import SftArguments; print(torch.__version__,torchvision.__version__,torch.version.cuda)' \
    && python -m pip freeze > /opt/requirements-runtime-lock.txt \
    && apt-get purge -y gcc libc6-dev && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* /tmp/requirements.txt /tmp/constraints.txt
